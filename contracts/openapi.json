{
  "openapi": "3.0.3",
  "info": {
    "title": "Autenticação de clientes",
    "version": "2.0.0",
    "description": "Código de uso único capturado no SMTP4dev; substitui customers/validate na publicação coordenada."
  },
  "paths": {
    "/customers/auth/request-code": {
      "post": {
        "operationId": "requestCustomerAccessCode",
        "summary": "Solicitar código de acesso do cliente",
        "description": "Sem token prévio ou bypass por Authorization. JSON UTF-8 estrito de até 4 KiB; base64 do evento Gateway é decodificado antes do limite. Cache-Control no-store em todas as respostas.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "document"
                ],
                "properties": {
                  "document": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 18,
                    "description": "CPF/CNPJ numérico válido com ou sem máscara. O parser compara propriedades sem distinguir maiúsculas e rejeita duplicações."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Corpo ou campos inválidos; não inicializa AWS/banco.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Limite/cooldown do cliente elegível atingido.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "description": "Segundos inteiros até nova solicitação permitida."
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Falha técnica/timeout sem detalhes internos.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "202": {
            "description": "Identificador opaco e mensagem genérica; não comprova existência ou captura.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "challengeId",
                    "message"
                  ],
                  "properties": {
                    "challengeId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "message": {
                      "type": "string",
                      "enum": [
                        "Se o cadastro estiver apto, um código será enviado."
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/customers/auth/verify-code": {
      "post": {
        "operationId": "verifyCustomerAccessCode",
        "summary": "Confirmar código de uso único e emitir JWT Customer",
        "description": "Sem token prévio ou bypass por Authorization. JSON UTF-8 estrito de até 4 KiB; base64 do evento Gateway é decodificado antes do limite. Cache-Control no-store em todas as respostas.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "document",
                  "challengeId",
                  "code"
                ],
                "properties": {
                  "document": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 18,
                    "description": "CPF/CNPJ numérico válido com ou sem máscara. O parser compara propriedades sem distinguir maiúsculas e rejeita duplicações."
                  },
                  "challengeId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Identificador não vazio do desafio."
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]{8}$",
                    "minLength": 8,
                    "maxLength": 8
                  }
                }
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Corpo ou campos inválidos; não inicializa AWS/banco.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Autenticação não autorizada; negativa genérica.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Falha técnica/timeout sem detalhes internos.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "200": {
            "description": "String JSON contendo JWT Customer válido por dez minutos.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "description": "JWT HS256, sem documento/código/OS nas claims."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "about:blank"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "enum": [
              "/customers/auth/request-code",
              "/customers/auth/verify-code",
              "/customers/auth"
            ]
          }
        }
      }
    }
  }
}
