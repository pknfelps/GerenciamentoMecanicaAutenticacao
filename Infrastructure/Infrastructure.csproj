<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GerenciamentoMecanica.Autenticacao.Infrastructure</AssemblyName>
    <RootNamespace>GerenciamentoMecanica.Autenticacao.Infrastructure</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Domain/Domain.csproj" />
    <ProjectReference Include="../Application/Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="GerenciamentoMecanica.Auth.Contracts" Version="[1.0.0]" />
    <PackageReference Include="AWSSDK.Core" Version="4.0.102.8" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.100.15" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="4.0.104.1" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Npgsql" Version="10.0.2" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="InfrastructureTests" />
    <None Update="Certificates/rds-ca.pem" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
